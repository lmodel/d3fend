d3fend:has_input dcterms:title "has-input" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEvent ;
	rdfs:label "has_input" ;
	rdfs:range d3fend:D3fendArtifact ;
	rdfs:seeAlso <http://purl.obolibrary.org/obo/RO_0002233> , <https://www.commoncoreontologies.org/ont00001921> ;
	rdfs:subPropertyOf d3fend:has_participant ;
