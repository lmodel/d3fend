	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:confidence dcterms:title "confidence" ;
	a owl:DatatypeProperty ;
	rdfs:label "confidence" ;
	rdfs:range xsd:string ;
	rdfs:subPropertyOf d3fend:d3fend_catalog_data_property ;
	skos:definition "D3FEND's property \"confidence\", which the ontology does not define." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "data" .
d3fend:configures dcterms:title "configures" ;
	a owl:ObjectProperty ;
	rdfs:label "configures" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with , d3fend:hardens ;
	skos:definition "x configures y: The entity x sets the operational parameters of entity y, determining how y will operate." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:connected_to dcterms:title "connected-to" ;
	a owl:ObjectProperty ;
	rdfs:label "connected_to" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
	skos:definition "x connected-to y: The subject x shares a direct physical or logical link with object y such that communication is possible between them without intermediate routing." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:connects dcterms:title "connects" ;
	a owl:ObjectProperty ;
	rdfs:label "connects" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
	skos:definition "x connects y: The subject x joins system y by means of communication equipment (to some other system, typically the adversary-targeted host)." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "http://wordnet-rdf.princeton.edu/id/01071413-v" ;
	d3fend:owl_property "object" .
d3fend:contained_by dcterms:title "contained-by" ;
	a owl:ObjectProperty , owl:TransitiveProperty ;
