d3fend:risk_impact dcterms:title "risk-impact" ;
	a owl:DatatypeProperty ;
	rdfs:label "risk_impact" ;
	rdfs:range _:c14n408 ;
	rdfs:subPropertyOf d3fend:d3fend_data_property ;
	skos:definition "Risk impact rating, expressed on a numeric scale from 1 (lowest impact) to 5 (highest impact) in the context of a 5x5 risk matrix. Impact is used here as a synonym for consequence, another popular term used in risk analysis." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "https://www.cto.mil/wp-content/uploads/2024/05/RIO-2023-2-2.pdf" ;
