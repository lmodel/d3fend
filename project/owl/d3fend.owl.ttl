	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "https://www.cto.mil/wp-content/uploads/2024/05/RIO-2023-2-2.pdf" ;
	d3fend:owl_property "data" .
d3fend:runs dcterms:title "runs" ;
	a owl:ObjectProperty ;
	rdfs:label "runs" ;
	rdfs:range d3fend:D3fendEntry ;
