	rdfs:label "related" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:semantic_relation ;
	skos:closeMatch skos:related ;
	skos:definition "x related y: x has a symmetric associative relation to y." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "http://www.w3.org/2004/02/skos/core#related" ;
