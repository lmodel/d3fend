@prefix d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix nist_sp_800_53: <https://w3id.org/lmodel/nist-sp-800-53/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix IAO: <http://purl.obolibrary.org/obo/IAO_> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix attack: <https://w3id.org/lmodel/attack/> .
@prefix d3fend: <https://w3id.org/lmodel/d3fend/> .
@prefix capec: <https://w3id.org/lmodel/capec/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix stix: <https://w3id.org/lmodel/stix/> .
@prefix cwe: <https://w3id.org/lmodel/cwe/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix linkml: <https://w3id.org/linkml/> .
@prefix pav: <http://purl.org/pav/> .
xsd:anyURI a rdfs:Datatype ;
	owl:equivalentClass xsd:string .
xsd:dateTime a rdfs:Datatype ;
	owl:equivalentClass _:c14n617 .
owl:Class dcterms:title "Class" ;
	a owl:Class ;
	rdfs:label "class" ;
	rdfs:subClassOf d3fend:D3fendOwlKind ;
	skos:definition "The term is an owl:Class only." .
owl:NamedIndividual dcterms:title "Individual" ;
	a owl:Class ;
	rdfs:label "individual" ;
	rdfs:subClassOf d3fend:D3fendOwlKind ;
	skos:definition "The term is an owl:NamedIndividual only." .
<https://w3id.org/lmodel/d3fend.owl.ttl> dcterms:license "Apache-2.0" ;
	dcterms:source <https://d3fend.mitre.org/ontologies/d3fend/1.6.0/d3fend.ttl> ;
	dcterms:title "MITRE D3FEND Knowledge Graph" ;
	pav:version "1.6.0" ;
	<http://schema.org/keywords> "D3FEND" , "countermeasure" , "cybersecurity" , "defensive technique" , "digital artifact" , "knowledge graph" ;
	a owl:Ontology ;
	rdfs:label "d3fend" ;
	rdfs:seeAlso <https://d3fend.mitre.org/> , <https://lmodel.github.io/d3fend> ;
	skos:definition "A LinkML model of MITRE D3FEND, the knowledge graph of cybersecurity countermeasures. It models the graph as a catalogue of records: each kind of entry is a class, each property of the ontology is a slot under its own IRI, and every term of D3FEND 1.6.0 is a record that validates against them." ;
	skos:note "The version is the edition of D3FEND the schema renders. upstream/ holds its Turtle file unchanged, scripts/d3fend_to_linkml.py writes the catalogue and the slots from it, and scripts/check_upstream_release.py reports when it moves." ;
	d3fend:upstream_commit "91629abb966e" ;
	d3fend:upstream_copyright "Copyright 2022 The MITRE Corporation" ;
	d3fend:upstream_release_date "2026-08-31" ;
	d3fend:upstream_tag "1.6.0" ;
	d3fend:upstream_terms "https://d3fend.mitre.org/tou" .
d3fend:D3fendAgent dcterms:title "Agent" ;
	a owl:Class ;
	rdfs:label "D3fendAgent" ;
	rdfs:subClassOf d3fend:D3fendEntry ;
	skos:definition "Something capable of intentional action, such as a person, an organization or an attacker." ;
	skos:exactMatch d3f:Agent ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:Agent" .
d3fend:D3fendAnalyticTechnique dcterms:title "Analytic Technique" ;
	a owl:Class ;
	rdfs:label "D3fendAnalyticTechnique" ;
	rdfs:subClassOf d3fend:D3fendTechnique ;
	skos:definition "A mathematical method a defensive technique can use to find patterns in data, such as a form of machine learning or a statistical measure." ;
	skos:exactMatch d3f:AnalyticTechnique ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:AnalyticTechnique" .
d3fend:D3fendArtifact dcterms:title "Artifact" ;
	a owl:Class ;
	rdfs:label "D3fendArtifact" ;
	rdfs:subClassOf d3fend:D3fendEntry , _:c14n117 , _:c14n189 , _:c14n400 , _:c14n610 , _:c14n66 , _:c14n70 ;
	skos:definition "A man-made thing that techniques act on. Those that are not digital, such as a physical lock, stay here." ;
	skos:exactMatch d3f:Artifact ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:Artifact" .
d3fend:D3fendAttackDataSource dcterms:title "ATT&CK Enterprise Data Source" ;
	a owl:Class ;
	rdfs:label "D3fendAttackDataSource" ;
	rdfs:subClassOf d3fend:D3fendThreatModelThing ;
	skos:closeMatch attack:AttackDataSource ;
	skos:definition "A data source of ATT&CK Enterprise, which D3FEND relates to its digital artifacts." ;
	skos:exactMatch d3f:ATTACKEnterpriseDataSource ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:ATTACKEnterpriseDataSource" .
d3fend:D3fendAttackMitigation dcterms:title "ATT&CK Enterprise Mitigation" ;
	a owl:Class ;
	rdfs:label "D3fendAttackMitigation" ;
	rdfs:subClassOf d3fend:D3fendThreatModelThing ;
	skos:closeMatch attack:AttackMitigation ;
	skos:definition "A mitigation of ATT&CK Enterprise, which D3FEND relates to its defensive techniques." ;
	skos:exactMatch d3f:ATTACKEnterpriseMitigation ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:ATTACKEnterpriseMitigation" .
d3fend:D3fendCatalog dcterms:title "Catalog" ;
	a owl:Class ;
	rdfs:label "D3fendCatalog" ;
	rdfs:subClassOf _:c14n100 , _:c14n139 , _:c14n142 , _:c14n154 , _:c14n180 , _:c14n193 , _:c14n194 , _:c14n250 , _:c14n372 , _:c14n4 , _:c14n45 , _:c14n457 , _:c14n482 , _:c14n489 , _:c14n510 , _:c14n588 , _:c14n598 , _:c14n616 , _:c14n62 , _:c14n632 , _:c14n657 , _:c14n670 , _:c14n674 , _:c14n683 , _:c14n689 , _:c14n78 , _:c14n9 ;
	skos:definition "One edition of the D3FEND ontology, with its header and all its entries." ;
	skos:inScheme <https://w3id.org/lmodel/d3fend> .
d3fend:D3fendCciControl dcterms:title "CCI Control" ;
	a owl:Class ;
	rdfs:label "D3fendCciControl" ;
	rdfs:subClassOf d3fend:D3fendExternalControl ;
	skos:definition "An item of the Control Correlation Identifier list that DISA publishes." ;
	skos:exactMatch d3f:CCIControl ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:CCIControl" .
d3fend:D3fendControlCatalog dcterms:title "Control Catalog" ;
	a owl:Class ;
	rdfs:label "D3fendControlCatalog" ;
	rdfs:subClassOf d3fend:D3fendEntry ;
	skos:definition "A published list of controls, one edition of which holds D3FEND's control entries as members." ;
	skos:exactMatch d3f:ControlCatalog ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:ControlCatalog" .
d3fend:D3fendDefensiveTactic dcterms:title "Defensive Tactic" ;
	a owl:Class ;
	rdfs:label "D3fendDefensiveTactic" ;
	rdfs:subClassOf d3fend:D3fendGoal ;
	skos:definition "One of D3FEND's seven defensive aims, such as Detect or Harden, which a defensive technique enables." ;
	skos:exactMatch d3f:DefensiveTactic ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:DefensiveTactic" .
d3fend:D3fendDefensiveTechnique dcterms:title "Defensive Technique" ;
	a owl:Class ;
	rdfs:label "D3fendDefensiveTechnique" ;
	rdfs:subClassOf d3fend:D3fendTechnique ;
	skos:definition "A countermeasure: a method that makes a system harder to attack, related to the artifacts it acts on and to the tactic it enables." ;
	skos:exactMatch d3f:DefensiveTechnique ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:DefensiveTechnique" .
d3fend:D3fendDigitalArtifact dcterms:title "Digital Artifact" ;
	a owl:Class ;
	rdfs:label "D3fendDigitalArtifact" ;
	rdfs:subClassOf d3fend:D3fendArtifact , _:c14n230 , _:c14n263 , _:c14n472 ;
	skos:definition "An artifact that carries information for a digital system, such as a file, a process or a network packet: the common ground where offensive and defensive techniques meet." ;
	skos:exactMatch d3f:DigitalArtifact ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:DigitalArtifact" .
d3fend:D3fendDisjointGroup dcterms:title "Disjoint Group" ;
	a owl:Class ;
	rdfs:label "D3fendDisjointGroup" ;
	rdfs:subClassOf _:c14n137 , _:c14n605 ;
	skos:definition "A set of D3FEND classes of which no two share an instance." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_type "owl:AllDisjointClasses" .
