	skos:definition "One term of the D3FEND graph, a class or an individual, as a record that holds its text and its relations to other terms." ;
	skos:inScheme d3fend:d3fend_entries ;
	skos:note "The ontology declares a domain for few of its properties, so this class lists every property that has none, and any kind of entry may hold it. A narrower kind lists a property only where the ontology declares that domain and this edition obeys it." .
d3fend:D3fendEvent dcterms:title "Event" ;
	a owl:Class ;
	rdfs:label "D3fendEvent" ;
	rdfs:subClassOf d3fend:D3fendEntry , _:c14n118 , _:c14n3 , _:c14n325 , _:c14n591 ;
	skos:definition "Something that happens in a system over a finite span of time, with the artifacts that take part in it." ;
	skos:exactMatch d3f:Event ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:Event" .
d3fend:D3fendExternalControl dcterms:title "External Control" ;
	a owl:Class ;
	rdfs:label "D3fendExternalControl" ;
	rdfs:subClassOf d3fend:D3fendEntry ;
	skos:definition "A control another catalogue defines, which D3FEND relates to its techniques." ;
	skos:exactMatch d3f:ExternalControl ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:ExternalControl" .
d3fend:D3fendGoal dcterms:title "Goal" ;
	a owl:Class ;
	rdfs:label "D3fendGoal" ;
	rdfs:subClassOf d3fend:D3fendEntry ;
	skos:definition "An aim that a tactic or a technique serves." ;
	skos:exactMatch d3f:Goal ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:Goal" .
d3fend:D3fendNistControl dcterms:title "NIST Control" ;
	a owl:Class ;
	rdfs:label "D3fendNistControl" ;
	rdfs:subClassOf d3fend:D3fendExternalControl ;
	skos:definition "A control or control enhancement of a revision of NIST SP 800-53." ;
	skos:exactMatch d3f:NISTControl ;
	skos:inScheme d3fend:d3fend_entries ;
	skos:relatedMatch nist_sp_800_53:Control , nist_sp_800_53:ControlEnhancement ;
	d3fend:d3fend_branches "d3f:NISTControl" .
d3fend:D3fendOffensiveTactic dcterms:title "Offensive Tactic" ;
	a owl:Class ;
	rdfs:label "D3fendOffensiveTactic" ;
	rdfs:subClassOf d3fend:D3fendGoal ;
	skos:definition "A tactic of an adversary, from the ATT&CK, ATLAS or SPARTA framework, which an offensive technique enables." ;
	skos:exactMatch d3f:OffensiveTactic ;
	skos:inScheme d3fend:d3fend_entries ;
	skos:relatedMatch attack:AttackTactic ;
	d3fend:d3fend_branches "d3f:OffensiveTactic" .
d3fend:D3fendOffensiveTechnique dcterms:title "Offensive Technique" ;
	a owl:Class ;
	rdfs:label "D3fendOffensiveTechnique" ;
	rdfs:subClassOf d3fend:D3fendTechnique ;
	skos:closeMatch attack:AttackTechnique ;
	skos:definition "A way an adversary acts, drawn from ATT&CK Enterprise, related to the artifacts it touches and to the tactic it serves." ;
	skos:exactMatch d3f:OffensiveTechnique ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:OffensiveTechnique" .
d3fend:D3fendOwlKind\#class_and_individual dcterms:title "Class and Individual" ;
	a owl:Class ;
	rdfs:label "class_and_individual" ;
	rdfs:subClassOf d3fend:D3fendOwlKind ;
	skos:definition "The term is punned, both an owl:Class and an owl:NamedIndividual." .
d3fend:D3fendOwlKind dcterms:title "OWL Kind" ;
	a owl:Class ;
	rdfs:label "D3fendOwlKind" ;
	owl:unionOf _:c14n579 ;
	skos:definition "How the ontology declares a term." ;
	skos:inScheme d3fend:d3fend_core ;
	linkml:permissible_values owl:Class , owl:NamedIndividual , d3fend:D3fendOwlKind\#class_and_individual .
d3fend:D3fendTechnique dcterms:title "Technique" ;
	a owl:Class ;
	rdfs:label "D3fendTechnique" ;
	rdfs:subClassOf d3fend:D3fendEntry , _:c14n410 , _:c14n552 ;
	skos:definition "A way of doing something in or to a computer system. Its narrower kinds say whose way it is." ;
	skos:exactMatch d3f:Technique ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:Technique" .
d3fend:D3fendTechniqueReference dcterms:title "Technique Reference" ;
	a owl:Class ;
	rdfs:label "D3fendTechniqueReference" ;
	rdfs:subClassOf d3fend:D3fendEntry , _:c14n168 , _:c14n377 , _:c14n434 , _:c14n631 , _:c14n64 , _:c14n648 ;
	skos:definition "A source behind a knowledge base article, such as a patent or a paper. rdf_type says which of D3FEND's reference types it is, since all of them hold the same fields." ;
	skos:exactMatch d3f:TechniqueReference ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:TechniqueReference" .
d3fend:D3fendThing dcterms:title "Thing" ;
	a owl:Class ;
	rdfs:label "D3fendThing" ;
	rdfs:subClassOf d3fend:D3fendEntry ;
	skos:definition "An entry with no narrower kind here: a root of D3FEND's tree, or a term such as a plan, a step, a group, a time or a condition." ;
	skos:inScheme d3fend:d3fend_entries .
d3fend:D3fendThreatModelTechnique dcterms:title "Threat Model Technique" ;
	a owl:Class ;
	rdfs:label "D3fendThreatModelTechnique" ;
	rdfs:subClassOf d3fend:D3fendThreatModelThing ;
	skos:definition "A technique of ATT&CK Mobile, ATT&CK ICS, ATLAS or SPARTA. D3FEND places these under their frameworks and not under its own offensive technique." ;
	skos:inScheme d3fend:d3fend_entries ;
	skos:relatedMatch attack:AttackTechnique ;
	d3fend:d3fend_branches "d3f:ATTACKMobileTechnique d3f:ATTACKICSTechnique d3f:ATLASTechnique d3f:SPARTATechnique" .
d3fend:D3fendThreatModelThing dcterms:title "Threat Model Thing" ;
	a owl:Class ;
	rdfs:label "D3fendThreatModelThing" ;
	rdfs:subClassOf d3fend:D3fendEntry ;
	skos:definition "A term from a threat model outside D3FEND, such as ATT&CK, ATLAS, SPARTA or CAPEC, with no narrower kind here." ;
	skos:exactMatch d3f:ExternalThreatModelThing ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:ExternalThreatModelThing" .
d3fend:D3fendWeakness dcterms:title "Weakness" ;
	a owl:Class ;
	rdfs:label "D3fendWeakness" ;
	rdfs:subClassOf d3fend:D3fendEntry , _:c14n21 , _:c14n496 ;
	skos:closeMatch cwe:CweWeakness ;
	skos:definition "A condition in a system component that can contribute to a vulnerability. Nearly all of these entries name a CWE entry." ;
	skos:exactMatch d3f:Weakness ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:d3fend_branches "d3f:Weakness" .
d3fend:abuses dcterms:title "abuses" ;
	a owl:ObjectProperty ;
	rdfs:label "abuses" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:uses ;
	skos:altLabel "misapplies" , "misuses" ;
	skos:definition "x abuses y: The entity x applies an artifact y to a wrong thing or person; x applies y badly or incorrectly." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "http://wordnet-rdf.princeton.edu/id/01163606-v" ;
	d3fend:owl_property "object" .
d3fend:access_mediated_by dcterms:title "access-mediated-by" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEntry ;
	rdfs:label "access_mediated_by" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
	owl:inverseOf d3fend:mediates_access_to ;
	skos:definition "x access-mediated-by y: The entity or resource x has its access regulated, controlled, or facilitated by entity y, which acts as an intermediary or gatekeeper to enforce access control policies." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:accessed_by dcterms:title "accessed-by" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEntry ;
	rdfs:label "accessed_by" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with , d3fend:may_be_accessed_by ;
	owl:inverseOf d3fend:accesses ;
	skos:definition "x accessed-by y: The entity or resource x is accessed by entity y." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:accesses dcterms:title "accesses" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEntry ;
	rdfs:label "accesses" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with , d3fend:may_access ;
	owl:inverseOf d3fend:accessed_by ;
	skos:definition "x accesses y: The subject x takes the action of reading from, writing into, or executing the stored information in the object y. Reads, writes, and executes are specific cases of accesses." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "http://wordnet-rdf.princeton.edu/id/02673854-n" ;
	d3fend:owl_property "object" .
d3fend:addressed_by dcterms:title "addressed-by" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEntry ;
	rdfs:label "addressed_by" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
	owl:inverseOf d3fend:addresses ;
	skos:definition "x addressed-by y: Relates a resource x (e.g., network host, peripheral device, disk sector, a memory cell or other logical or physical entity) to a discrete address y in an address space that points to it." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:addresses dcterms:title "addresses" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEntry ;
	rdfs:label "addresses" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:seeAlso <http://dbpedia.org/resource/Pointer_(computer_programming)> , <http://wordnet-rdf.princeton.edu/id/02253826-v> ;
	rdfs:subPropertyOf d3fend:associated_with ;
	owl:inverseOf d3fend:addressed_by ;
	skos:altLabel "points-to" ;
	skos:definition "x addresses y: Relates a pointer x to a digital artifact y located in the address space to which x points. The address space is part of some digital store, whether it be in memory, an image, or a persistent storage device." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:adds dcterms:title "adds" ;
	a owl:ObjectProperty ;
	rdfs:label "adds" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with , d3fend:may_add ;
	skos:definition "x adds y: The subject x adds a data object y, such as a file, to some other digital artifact, such as a directory. Examples include an agent or technique adding a record to a database or a domain entry to a DNS server." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:alt_label dcterms:title "altLabel" ;
	a owl:DatatypeProperty ;
	rdfs:label "alt_label" ;
	rdfs:range xsd:string ;
	skos:definition "D3FEND's property \"altLabel\", which the ontology does not define." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "annotation" .
d3fend:analyzes dcterms:title "analyzes" ;
	a owl:ObjectProperty ;
	rdfs:label "analyzes" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with , d3fend:detects ;
	skos:definition "x analyzes y: The subject x breaks down object y into components or essential features, assessing y by quantitative methods, qualitative methods, or both. Usually the analysis is done in terms of some model or framework." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "http://wordnet-rdf.princeton.edu/id/00738221-v" ;
	d3fend:owl_property "object" .
d3fend:archived_at dcterms:title "archived-at" ;
	a owl:DatatypeProperty ;
	rdfs:label "archived_at" ;
	rdfs:range xsd:anyURI ;
	rdfs:subPropertyOf d3fend:d3fend_catalog_data_property ;
	skos:definition "D3FEND's property \"archived-at\", which the ontology does not define." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "data" .
d3fend:associated_with dcterms:title "associated-with" ;
	a owl:ObjectProperty ;
	rdfs:label "associated_with" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:seeAlso <http://wordnet-rdf.princeton.edu/id/13804981-n> ;
	rdfs:subPropertyOf d3fend:may_be_associated_with ;
	skos:definition "x associated-with y: The subject x and object y are associated in some way. This is the most general definite relationship in d3fend (i.e., most general relationship that is not prefixed by 'may-'.)" ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:attached_to dcterms:title "attached-to" ;
	a owl:ObjectProperty ;
	rdfs:label "attached_to" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:seeAlso d3f:connects ;
	rdfs:subPropertyOf d3fend:associated_with ;
	skos:definition "x attached-to y: A subject x is joined in close association to an object y." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "http://wordnet-rdf.princeton.edu/id/01980375-s" ;
	d3fend:owl_property "object" .
d3fend:attack_id dcterms:title "attack-id" ;
	a owl:DatatypeProperty ;
	rdfs:label "attack_id" ;
	rdfs:range xsd:string ;
	rdfs:subPropertyOf d3fend:attack_kb_annotation ;
	skos:definition "x attack-id y: The offensive technique x has the att&ck unique id of y." ;
	skos:inScheme d3fend:d3fend_entries ;
	skos:note "D3FEND declares the domain d3f:OffensiveTechnique, but this edition also uses the property outside it, so every kind may hold this slot." ;
	skos:relatedMatch stix:external_id ;
	d3fend:owl_domain "d3f:OffensiveTechnique" ;
	d3fend:owl_property "annotation" .
d3fend:attack_kb_annotation dcterms:title "attack-kb-annotation" ;
	a owl:DatatypeProperty ;
	rdfs:label "attack_kb_annotation" ;
	rdfs:range xsd:string ;
	rdfs:subPropertyOf d3fend:d3fend_annotation ;
	skos:definition "x attack-kb-annotation y: The offensive technique x has the kb annotation of y." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_domain "d3f:OffensiveTechnique" ;
	d3fend:owl_property "annotation" .
d3fend:attack_kb_data_property dcterms:title "attack-kb-data-property" ;
	a owl:DatatypeProperty ;
	rdfs:label "attack_kb_data_property" ;
	rdfs:range xsd:string ;
	skos:altLabel "attack-kb-property" ;
	skos:definition "D3FEND's property \"attack-kb-data-property\", which the ontology does not define." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "data" .
d3fend:attack_may_be_countered_by dcterms:title "attack-may-be-countered-by" ;
	a owl:ObjectProperty ;
	rdfs:label "attack_may_be_countered_by" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:may_be_tactically_associated_with ;
	skos:definition "D3FEND's property \"attack-may-be-countered-by\", which the ontology does not define." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:authenticates dcterms:title "authenticates" ;
	a owl:ObjectProperty ;
	rdfs:label "authenticates" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with , d3fend:hardens ;
	skos:definition "x authenticates y: The subject x establishes the authenticity of some y. This relation indicates an authentication event has occurred." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "http://wordnet-rdf.princeton.edu/id/01980375-s" ;
	d3fend:owl_property "object" .
d3fend:authorizes dcterms:title "authorizes" ;
	a owl:ObjectProperty ;
	rdfs:label "authorizes" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:seeAlso <http://wordnet-rdf.princeton.edu/id/00805664-v> ;
	rdfs:subPropertyOf d3fend:associated_with , d3fend:hardens ;
	skos:definition "x authorizes y: A subject x grants authorization or clearance for an agent y to use an object. This relation indicates an authorization event has occurred." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "http://wordnet-rdf.princeton.edu/id/00804987-v" ;
	d3fend:owl_property "object" .
d3fend:available dcterms:title "date available" ;
	a owl:DatatypeProperty ;
	rdfs:label "available" ;
	rdfs:range xsd:dateTime ;
	rdfs:subPropertyOf d3fend:date_value ;
	skos:definition "Date that the resource became or will become available." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "data" .
d3fend:blocks dcterms:title "blocks" ;
	a owl:ObjectProperty ;
	rdfs:label "blocks" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:counters , d3fend:filters , d3fend:may_block ;
	skos:definition "x blocks y: The entity x blocks off the use of digital artifact y by reference to a block or allow list (or both.)" ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "http://wordnet-rdf.princeton.edu/id/01480024-v" ;
	d3fend:owl_property "object" .
d3fend:broader dcterms:title "broader" ;
	a owl:ObjectProperty ;
	rdfs:label "broader" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:semantic_relation ;
	skos:definition "x broader y: The entity x represents a more general or inclusive concept than entity y." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:broader_transitive dcterms:title "broader-transitive" ;
	a owl:ObjectProperty ;
	rdfs:label "broader_transitive" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:semantic_relation ;
	skos:definition "x broader-transitive y: The entity x represents a more general concept than entity y, including indirect or hierarchical relationships where x encompasses y through intermediate entities." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:capec_id dcterms:title "capec-id" ;
	a owl:DatatypeProperty ;
	rdfs:label "capec_id" ;
	rdfs:range xsd:string ;
	rdfs:subPropertyOf d3fend:d3fend_kb_data_property ;
	skos:definition "Unique identifier for a CAPEC technique, i.e. a common attack pattern identified by the pattern CAPEC-[number]." ;
	skos:inScheme d3fend:d3fend_entries ;
	skos:relatedMatch capec:CAPEC_ID ;
	d3fend:owl_property "data" .
d3fend:carried_by dcterms:title "carried-by" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEntry ;
	rdfs:label "carried_by" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
	owl:inverseOf d3fend:carries ;
	skos:definition "x carried-by y: The information entity x is dependent upon the entity y for its storage, transport, or communication. Entity y serves as the necessary bearer or link from which x can be recovered or interpreted." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:carries dcterms:title "carries" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEntry ;
	rdfs:label "carries" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
	owl:inverseOf d3fend:carried_by ;
	skos:definition "x carries y: The entity x serves as the bearer or link for information y, enabling y to be stored, transported, or communicated such that y can be recovered or interpreted from x" ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_property "object" .
d3fend:caused_by dcterms:title "caused-by" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEntry ;
	rdfs:label "caused_by" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
	owl:inverseOf d3fend:causes ;
	skos:definition "x caused-by y: The event or action x occurs as a consequence of event or action y." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "https://www.commoncoreontologies.org/ont00001819" ;
	d3fend:owl_property "object" .
d3fend:causes dcterms:title "causes" ;
	a owl:ObjectProperty ;
	rdfs:domain d3fend:D3fendEntry ;
	rdfs:label "causes" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
	owl:inverseOf d3fend:caused_by ;
	skos:definition "x causes y: The event or action x brings about event or action y as a consequence." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:is_defined_by "https://www.commoncoreontologies.org/ont00001803" ;
	d3fend:owl_property "object" .
d3fend:comment dcterms:title "Comment" ;
	a owl:DatatypeProperty ;
	rdfs:label "comment" ;
	rdfs:range xsd:string ;
	skos:definition "A note on the term, in MITRE's words." ;
	skos:inScheme d3fend:d3fend_entries .
d3fend:comments dcterms:title "comments" ;
	a owl:DatatypeProperty ;
	rdfs:label "comments" ;
	rdfs:range xsd:string ;
	rdfs:subPropertyOf d3fend:d3fend_catalog_data_property ;
	skos:definition "x comments y: x claim has provider comments y." ;
	skos:inScheme d3fend:d3fend_entries ;
	d3fend:owl_functional "true" ;
	d3fend:owl_property "data" .
d3fend:communicates_with dcterms:title "communicates-with" ;
	a owl:ObjectProperty , owl:SymmetricProperty ;
	rdfs:label "communicates_with" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
