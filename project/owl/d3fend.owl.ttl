	rdfs:label "semantic_relation" ;
	rdfs:range d3fend:D3fendEntry ;
	rdfs:subPropertyOf d3fend:associated_with ;
	skos:definition "x semantic-relation y: The entity x is conceptually or meaningfully connected to entity y." ;
	skos:inScheme d3fend:d3fend_entries ;
