<https://w3id.org/lmodel/d3fend/injects> dcterms:title "injects" ;
	a linkml:SlotDefinition ;
	rdfs:seeAlso "http://dbpedia.org/resource/Code_injection"^^xsd:anyURI , "http://wordnet-rdf.princeton.edu/id/00916722-v"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/d3fend/d3fend_entries"^^xsd:anyURI ;
