	linkml:definition_uri "https://w3id.org/lmodel/d3fend/signs"^^xsd:anyURI ;
	linkml:description "x signs y: The entity x applies a digital signature to the digital artifact y, thereby asserting its validity, integrity, and authenticity. Typically, this involves cryptographic techniques to securely bind the signature to y, ensuring that y's contents have not been altered and are authentic as endorsed by x." ;
	linkml:domain <https://w3id.org/lmodel/d3fend/D3fendEntry> ;
