	skos:mappingRelation "http://d3fend.mitre.org/ontologies/d3fend.owl#addressed-by"^^xsd:anyURI ;
	linkml:annotations _:c14n9 ;
	linkml:definition_uri "https://w3id.org/lmodel/d3fend/addressed_by"^^xsd:anyURI ;
	linkml:description "x addressed-by y: Relates a resource x (e.g., network host, peripheral device, disk sector, a memory cell or other logical or physical entity) to a discrete address y in an address space that points to it." ;
