<https://w3id.org/lmodel/d3fend/accesses> dcterms:title "accesses" ;
	a linkml:SlotDefinition ;
	owl:inverseOf <https://w3id.org/lmodel/d3fend/accessed_by> ;
	skos:inScheme "https://w3id.org/lmodel/d3fend/d3fend_entries"^^xsd:anyURI ;
	skos:mappingRelation "http://d3fend.mitre.org/ontologies/d3fend.owl#accesses"^^xsd:anyURI ;
	linkml:annotations _:c14n164 , _:c14n341 ;
	linkml:definition_uri "https://w3id.org/lmodel/d3fend/accesses"^^xsd:anyURI ;
	linkml:description "x accesses y: The subject x takes the action of reading from, writing into, or executing the stored information in the object y. Reads, writes, and executes are specific cases of accesses." ;
	linkml:domain <https://w3id.org/lmodel/d3fend/D3fendEntry> ;
	linkml:domain_of <https://w3id.org/lmodel/d3fend/D3fendEntry> ;
