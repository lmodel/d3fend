<https://w3id.org/lmodel/d3fend/abuses> dcterms:title "abuses" ;
	a linkml:SlotDefinition ;
	skos:altLabel "misapplies" , "misuses" ;
	skos:inScheme "https://w3id.org/lmodel/d3fend/d3fend_entries"^^xsd:anyURI ;
	skos:mappingRelation "http://d3fend.mitre.org/ontologies/d3fend.owl#abuses"^^xsd:anyURI ;
	linkml:annotations _:c14n146 , _:c14n161 ;
	linkml:definition_uri "https://w3id.org/lmodel/d3fend/abuses"^^xsd:anyURI ;
	linkml:description "x abuses y: The entity x applies an artifact y to a wrong thing or person; x applies y badly or incorrectly." ;
	linkml:domain <https://w3id.org/lmodel/d3fend/D3fendEntry> ;
	linkml:domain_of <https://w3id.org/lmodel/d3fend/D3fendEntry> ;
	linkml:is_a <https://w3id.org/lmodel/d3fend/uses> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/d3fend/D3fendEntry> ;
	linkml:range <https://w3id.org/lmodel/d3fend/D3fendEntry> ;
	linkml:slot_uri "http://d3fend.mitre.org/ontologies/d3fend.owl#abuses"^^xsd:anyURI .
<https://w3id.org/lmodel/d3fend/access_mediated_by> dcterms:title "access-mediated-by" ;
	a linkml:SlotDefinition ;
	owl:inverseOf <https://w3id.org/lmodel/d3fend/mediates_access_to> ;
	skos:inScheme "https://w3id.org/lmodel/d3fend/d3fend_entries"^^xsd:anyURI ;
