	linkml:definition_uri "https://w3id.org/lmodel/d3fend/accessed_by"^^xsd:anyURI ;
	linkml:description "x accessed-by y: The entity or resource x is accessed by entity y." ;
	linkml:domain <https://w3id.org/lmodel/d3fend/D3fendEntry> ;
	linkml:domain_of <https://w3id.org/lmodel/d3fend/D3fendEntry> ;
	linkml:is_a <https://w3id.org/lmodel/d3fend/associated_with> ;
	linkml:mixins <https://w3id.org/lmodel/d3fend/may_be_accessed_by> ;
	linkml:multivalued true ;
