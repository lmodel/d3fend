      "class_uri": "http://d3fend.mitre.org/ontologies/d3fend.owl#CCIControl",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "owl_kind",
                "required": true,
                "equals_string": "individual",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "published",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A class restriction on CCIControl states that its instances hold published, and every individual of this edition does.",
          "title": "An individual holds published",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
