      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "owl_kind",
                "required": true,
                "equals_string": "individual",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "version",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A class restriction on ControlCatalog states that its instances hold version, and every individual of this edition does.",
          "title": "An individual holds version",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
