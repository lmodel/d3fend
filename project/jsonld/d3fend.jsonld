    {
      "name": "D3fendEntry",
      "definition_uri": "https://w3id.org/lmodel/d3fend/D3fendEntry",
      "description": "One term of the D3FEND graph, a class or an individual, as a record that holds its text and its relations to other terms.",
      "title": "Entry",
      "comments": [
        "The ontology declares a domain for few of its properties, so this class lists every property that has none, and any kind of entry may hold it. A narrower kind lists a property only where the ontology declares that domain and this edition obeys it."
      ],
