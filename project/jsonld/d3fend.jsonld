      "slot_usage": {},
      "class_uri": "http://d3fend.mitre.org/ontologies/d3fend.owl#TechniqueReference",
      "rules": [
        {
          "preconditions": {
            "slot_conditions": [
              {
                "name": "owl_kind",
                "required": true,
                "equals_string": "individual",
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "postconditions": {
            "slot_conditions": [
              {
                "name": "has_link",
                "required": true,
                "@type": "SlotDefinition"
              },
              {
                "name": "kb_reference_title",
                "required": true,
                "@type": "SlotDefinition"
              }
            ],
            "@type": "AnonymousClassExpression"
          },
          "description": "A class restriction on TechniqueReference states that its instances hold has_link and kb_reference_title, and every individual of this edition does.",
          "title": "An individual holds has_link and kb_reference_title",
          "@type": "ClassRule"
        }
      ],
      "@type": "ClassDefinition"
    },
