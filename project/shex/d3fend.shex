# metamodel_version: 1.12.0
# version: 1.6.0
BASE <https://w3id.org/lmodel/d3fend/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX d3f: <http://d3fend.mitre.org/ontologies/d3fend.owl#>
PREFIX linkml: <https://w3id.org/linkml/>


linkml:String xsd:string

linkml:Integer xsd:integer

linkml:Boolean xsd:boolean

linkml:Float xsd:float

linkml:Double xsd:double

linkml:Decimal xsd:decimal

linkml:Time xsd:time

linkml:Date xsd:date

linkml:Datetime xsd:dateTime

linkml:DateOrDatetime linkml:DateOrDatetime

linkml:Uriorcurie IRI

linkml:Curie xsd:string

linkml:Uri IRI

linkml:Ncname xsd:string

linkml:Objectidentifier IRI

linkml:Nodeidentifier NONLITERAL

linkml:Jsonpointer xsd:string

linkml:Jsonpath xsd:string

linkml:Sparqlpath xsd:string

<D3fendDateTime> xsd:dateTime

<D3fendUri> IRI

<D3fendAgent> CLOSED {
    (  $<D3fendAgent_tes> (  &<D3fendEntry_tes> ;
          rdf:type [ <D3fendEntry> ] ?
       ) ;
       rdf:type [ d3f:Agent ]
    )
}

<D3fendAnalyticTechnique> CLOSED {
    (  $<D3fendAnalyticTechnique_tes> (  &<D3fendTechnique_tes> ;
          rdf:type [ d3f:Technique ] ?
       ) ;
       rdf:type [ d3f:AnalyticTechnique ]
    )
}

<D3fendArtifact>  (
    CLOSED {
       (  $<D3fendArtifact_tes> (  &<D3fendEntry_tes> ;
             rdf:type [ <D3fendEntry> ] ? ;
             d3f:input-of @<D3fendEvent> * ;
             d3f:may-have-weakness @<D3fendWeakness> * ;
             d3f:output-of @<D3fendEvent> *
          ) ;
          rdf:type [ d3f:Artifact ]
       )
    } OR @<D3fendDigitalArtifact>
)

<D3fendAttackDataSource> CLOSED {
    (  $<D3fendAttackDataSource_tes> (  &<D3fendThreatModelThing_tes> ;
          rdf:type [ d3f:ExternalThreatModelThing ] ?
       ) ;
       rdf:type [ d3f:ATTACKEnterpriseDataSource ]
    )
}

<D3fendAttackMitigation> CLOSED {
    (  $<D3fendAttackMitigation_tes> (  &<D3fendThreatModelThing_tes> ;
          rdf:type [ d3f:ExternalThreatModelThing ] ?
       ) ;
       rdf:type [ d3f:ATTACKEnterpriseMitigation ]
    )
}

<D3fendCatalog> CLOSED {
    (  $<D3fendCatalog_tes> (  rdfs:comment @linkml:String * ;
          d3f:release-date @linkml:String ? ;
          owl:versionInfo @linkml:String ;
          owl:versionIRI @linkml:Uri ? ;
          dcterms:title @linkml:String ? ;
          dcterms:description @linkml:String ? ;
          dcterms:license @linkml:String ? ;
          <disjoint_groups> @<D3fendDisjointGroup> * ;
          <entries> @<D3fendEntry> +
       ) ;
       rdf:type [ <D3fendCatalog> ]
    )
}

<D3fendCciControl> CLOSED {
    (  $<D3fendCciControl_tes> (  &<D3fendExternalControl_tes> ;
          rdf:type [ d3f:ExternalControl ] ?
       ) ;
       rdf:type [ d3f:CCIControl ]
    )
}

<D3fendControlCatalog> CLOSED {
    (  $<D3fendControlCatalog_tes> (  &<D3fendEntry_tes> ;
          rdf:type [ <D3fendEntry> ] ?
       ) ;
       rdf:type [ d3f:ControlCatalog ]
    )
}

<D3fendDefensiveTactic> CLOSED {
    (  $<D3fendDefensiveTactic_tes> (  &<D3fendGoal_tes> ;
          rdf:type [ d3f:Goal ] ?
       ) ;
       rdf:type [ d3f:DefensiveTactic ]
    )
}

<D3fendDefensiveTechnique> CLOSED {
    (  $<D3fendDefensiveTechnique_tes> (  &<D3fendTechnique_tes> ;
          rdf:type [ d3f:Technique ] ?
       ) ;
       rdf:type [ d3f:DefensiveTechnique ]
    )
}

<D3fendDigitalArtifact> CLOSED {
    (  $<D3fendDigitalArtifact_tes> (  &<D3fendArtifact_tes> ;
          rdf:type [ d3f:Artifact ] ? ;
          d3f:process-security-context @linkml:String ?
       ) ;
       rdf:type [ d3f:DigitalArtifact ]
    )
}

<D3fendDisjointGroup> CLOSED {
    (  $<D3fendDisjointGroup_tes> owl:members @<D3fendEntry> + ;
       rdf:type [ <D3fendDisjointGroup> ] ?
    )
}

<D3fendEntry>  (
    @<D3fendAgent> OR @<D3fendArtifact> OR @<D3fendControlCatalog> OR @<D3fendEvent> OR @<D3fendExternalControl> OR @<D3fendGoal>
    OR @<D3fendTechnique> OR @<D3fendTechniqueReference> OR @<D3fendThing> OR @<D3fendThreatModelThing> OR @<D3fendWeakness>
)

<D3fendEntry_struct> {
    (  $<D3fendEntry_tes> (  <type> @linkml:String ;
          <owl_kind> [ owl:Class owl:NamedIndividual <https://w3id.org/lmodel/d3fend/D3fendOwlKind#class_and_individual> ] ? ;
          rdf:type @<D3fendEntry> * ;
          rdfs:subClassOf @<D3fendEntry> * ;
          d3f:abuses @<D3fendEntry> * ;
          d3f:access-mediated-by @<D3fendEntry> * ;
          d3f:accessed-by @<D3fendEntry> * ;
          d3f:accesses @<D3fendEntry> * ;
          d3f:addressed-by @<D3fendEntry> * ;
          d3f:addresses @<D3fendEntry> * ;
          d3f:adds @<D3fendEntry> * ;
          skos:altLabel @linkml:String * ;
          d3f:analyzes @<D3fendEntry> * ;
          d3f:archived-at @<D3fendUri> ? ;
          d3f:associated-with @<D3fendEntry> * ;
          d3f:attached-to @<D3fendEntry> * ;
          d3f:attack-id @linkml:String ? ;
          d3f:attack-may-be-countered-by @<D3fendEntry> * ;
          d3f:authenticates @<D3fendEntry> * ;
          d3f:authorizes @<D3fendEntry> * ;
          d3f:available @<D3fendDateTime> ? ;
          d3f:blocks @<D3fendEntry> * ;
          d3f:broader @<D3fendEntry> * ;
          d3f:broader-transitive @<D3fendEntry> * ;
          d3f:capec-id @linkml:String ? ;
          d3f:carried-by @<D3fendEntry> * ;
          d3f:carries @<D3fendEntry> * ;
          d3f:caused-by @<D3fendEntry> * ;
          d3f:causes @<D3fendEntry> * ;
          rdfs:comment @linkml:String * ;
          d3f:comments @linkml:String ? ;
          d3f:communicates-with @<D3fendEntry> * ;
          d3f:confidence @linkml:String ? ;
          d3f:configures @<D3fendEntry> * ;
          d3f:connected-to @<D3fendEntry> * ;
          d3f:connects @<D3fendEntry> * ;
          d3f:contained-by @<D3fendEntry> * ;
          d3f:contains @<D3fendEntry> * ;
          d3f:contributor @<D3fendEntry> * ;
          d3f:control-name @linkml:String ? ;
          d3f:controlled-by @<D3fendEntry> * ;
          d3f:controls @<D3fendEntry> * ;
          d3f:copies @<D3fendEntry> * ;
          d3f:copy-of @<D3fendEntry> * ;
          d3f:corrupts @<D3fendEntry> * ;
          d3f:counters @<D3fendEntry> * ;
          d3f:created @<D3fendDateTime> ? ;
          d3f:created-by @<D3fendEntry> * ;
          d3f:creates @<D3fendEntry> * ;
          d3f:cwe-id @linkml:String ? ;
          d3f:label @linkml:String * ;
          d3f:d3fend-annotation @linkml:String ? ;
          d3f:d3fend-comment @linkml:String ? ;
          d3f:d3fend-id @linkml:String ? ;
          d3f:date @<D3fendDateTime> ? ;
          d3f:deceives @<D3fendEntry> * ;
          d3f:deceives-with @<D3fendEntry> * ;
          d3f:decodes @<D3fendEntry> * ;
          d3f:definition @linkml:String * ;
          d3f:deletes @<D3fendEntry> * ;
          d3f:dependent @<D3fendEntry> * ;
          d3f:depends-on @<D3fendEntry> * ;
          owl:deprecated @linkml:Boolean ? ;
          d3f:derived-from @<D3fendEntry> * ;
          d3f:description @linkml:String ? ;
          d3f:detects @<D3fendEntry> * ;
          d3f:disables @<D3fendEntry> * ;
          owl:disjointWith @<D3fendEntry> * ;
          d3f:display-baseurl @linkml:String ? ;
          d3f:display-order @linkml:Integer ? ;
          d3f:display-priority @linkml:Integer ? ;
          d3f:drives @<D3fendEntry> * ;
          d3f:employed-by @<D3fendEntry> * ;
          d3f:employs @<D3fendEntry> * ;
          d3f:enabled-by @<D3fendEntry> * ;
          d3f:enables @<D3fendEntry> * ;
          d3f:encodes @<D3fendEntry> * ;
          d3f:encrypts @<D3fendEntry> * ;
          d3f:end @<D3fendEntry> * ;
          d3f:enforces @<D3fendEntry> * ;
          d3f:enumerates @<D3fendEntry> * ;
          d3f:erases @<D3fendEntry> * ;
          d3f:evaluated-by @<D3fendEntry> * ;
          d3f:evaluates @<D3fendEntry> * ;
          d3f:evicts @<D3fendEntry> * ;
          d3f:exactly @<D3fendEntry> * ;
          skos:example @linkml:String ? ;
          d3f:excises @<D3fendEntry> * ;
          d3f:executed-by @<D3fendEntry> * ;
          d3f:executes @<D3fendEntry> * ;
          d3f:expectation-rating @linkml:String ? ;
          d3f:extends @<D3fendEntry> * ;
          d3f:filters @<D3fendEntry> * ;
          d3f:forges @<D3fendEntry> * ;
          d3f:fork @<D3fendEntry> * ;
          d3f:hardens @<D3fendEntry> * ;
          d3f:has-account @<D3fendEntry> * ;
          d3f:has-agent @<D3fendEntry> * ;
          d3f:has-audience @<D3fendEntry> * ;
          d3f:has-contribution @<D3fendEntry> * ;
          d3f:has-contributor @<D3fendEntry> * ;
          d3f:has-dependent @<D3fendEntry> * ;
          d3f:has-goal @<D3fendEntry> * ;
          d3f:has-link @<D3fendUri> ? ;
          d3f:has-location @<D3fendEntry> * ;
          d3f:has-mediator @<D3fendEntry> * ;
          d3f:has-member @<D3fendEntry> * ;
          d3f:has-operating-mode @<D3fendEntry> * ;
          d3f:has-participant @<D3fendEntry> * ;
          d3f:has-prerequisite @<D3fendEntry> * ;
          d3f:has-procedure @<D3fendEntry> * ;
          d3f:has-recipient @<D3fendEntry> * ;
          d3f:has-sender @<D3fendEntry> * ;
          d3f:has-weakness @<D3fendEntry> * ;
          d3f:hides @<D3fendDigitalArtifact> * ;
          d3f:identified-by @<D3fendEntry> * ;
          d3f:identifier @linkml:String ? ;
          d3f:identifies @<D3fendEntry> * ;
          d3f:impairs @<D3fendEntry> * ;
          d3f:implemented-by @<D3fendEntry> * ;
          d3f:implements @<D3fendEntry> * ;
          d3f:initiates @<D3fendEntry> * ;
          d3f:injects @<D3fendEntry> * ;
          d3f:installs @<D3fendEntry> * ;
          d3f:instructed-by @<D3fendEntry> * ;
          d3f:instructs @<D3fendEntry> * ;
          d3f:interprets @<D3fendEntry> * ;
          d3f:inventoried-by @<D3fendEntry> * ;
          d3f:inventories @<D3fendEntry> * ;
          d3f:invoked-by @<D3fendEntry> * ;
          d3f:invokes @<D3fendEntry> * ;
          rdfs:isDefinedBy @linkml:String * ;
          d3f:isolates @<D3fendEntry> * ;
          d3f:issued @<D3fendDateTime> ? ;
          d3f:jams @<D3fendEntry> * ;
          d3f:kb-abstract @linkml:String ? ;
          d3f:kb-article @linkml:String * ;
          d3f:kb-organization @linkml:String ? ;
          d3f:kb-reference-of @<D3fendTechnique> * ;
          d3f:kb-reference-title @linkml:String ? ;
          rdfs:label @linkml:String * ;
          d3f:limits @<D3fendEntry> * ;
          d3f:loaded-by @<D3fendEntry> * ;
          d3f:loads @<D3fendEntry> * ;
          d3f:manages @<D3fendEntry> * ;
          d3f:mapped-by @<D3fendEntry> * ;
          d3f:maps @<D3fendEntry> * ;
          d3f:may-access @<D3fendEntry> * ;
          d3f:may-add @<D3fendEntry> * ;
          d3f:may-be-accessed-by @<D3fendEntry> * ;
          d3f:may-be-associated-with @<D3fendEntry> * ;
          d3f:may-be-contained-by @<D3fendEntry> * ;
          d3f:may-be-created-by @<D3fendEntry> * ;
          d3f:may-be-deceived-by @<D3fendEntry> * ;
          d3f:may-be-detected-by @<D3fendEntry> * ;
          d3f:may-be-evicted-by @<D3fendEntry> * ;
          d3f:may-be-hardened-against-by @<D3fendEntry> * ;
          d3f:may-be-invoked-by @<D3fendEntry> * ;
          d3f:may-be-isolated-by @<D3fendEntry> * ;
          d3f:may-be-modified-by @<D3fendEntry> * ;
          d3f:may-be-tactically-associated-with @<D3fendEntry> * ;
          d3f:may-block @<D3fendEntry> * ;
          d3f:may-contain @<D3fendEntry> * ;
          d3f:may-corrupt @<D3fendEntry> * ;
          d3f:may-counter @<D3fendEntry> * ;
          d3f:may-counter-attack @<D3fendEntry> * ;
          d3f:may-create @<D3fendEntry> * ;
          d3f:may-deceive @<D3fendEntry> * ;
          d3f:may-detect @<D3fendEntry> * ;
          d3f:may-disable @<D3fendEntry> * ;
          d3f:may-evaluate @<D3fendEntry> * ;
          d3f:may-evict @<D3fendEntry> * ;
          d3f:may-execute @<D3fendEntry> * ;
          d3f:may-harden @<D3fendEntry> * ;
          d3f:may-interpret @<D3fendEntry> * ;
          d3f:may-invoke @<D3fendEntry> * ;
          d3f:may-isolate @<D3fendEntry> * ;
          d3f:may-map @<D3fendEntry> * ;
          d3f:may-modify @<D3fendEntry> * ;
          d3f:may-produce @<D3fendEntry> * ;
          d3f:may-query @<D3fendEntry> * ;
          d3f:may-run @<D3fendEntry> * ;
          d3f:may-transfer @<D3fendEntry> * ;
          d3f:mediates-access-to @<D3fendEntry> * ;
          d3f:member-of @<D3fendEntry> * ;
          d3f:modified @<D3fendDateTime> ? ;
          d3f:modified-by @<D3fendEntry> * ;
          d3f:modifies @<D3fendEntry> * ;
          d3f:modifies-part @<D3fendEntry> * ;
          d3f:monitors @<D3fendEntry> * ;
          d3f:name @linkml:String ? ;
          d3f:narrower @<D3fendEntry> * ;
          d3f:narrower-transitive @<D3fendEntry> * ;
          d3f:neutralizes @<D3fendEntry> * ;
          d3f:next @<D3fendEntry> * ;
          d3f:obfuscates @<D3fendEntry> * ;
          d3f:operates @<D3fendEntry> * ;
          d3f:operating-system @linkml:String ? ;
          d3f:originates-from @<D3fendEntry> * ;
          d3f:owns @<D3fendEntry> * ;
          d3f:participates-in @<D3fendEntry> * ;
          d3f:powered-by @<D3fendEntry> * ;
          d3f:powers @<D3fendEntry> * ;
          d3f:preceded-by @<D3fendEntry> * ;
          d3f:precedes @<D3fendEntry> * ;
          d3f:pref-label @linkml:String ? ;
          d3f:prescribed-by @<D3fendEntry> * ;
          d3f:prescribes @<D3fendEntry> * ;
          d3f:process-ancestor @<D3fendEntry> * ;
          d3f:process-command-line-arguments @linkml:String ? ;
          d3f:process-environmental-variables @linkml:String ? ;
          d3f:process-identifier @linkml:String ? ;
          d3f:process-image-path @<D3fendEntry> * ;
          d3f:process-parent @<D3fendEntry> * ;
          d3f:process-user @<D3fendEntry> * ;
          d3f:produced-by @<D3fendEntry> * ;
          d3f:produces @<D3fendEntry> * ;
          d3f:provider @<D3fendEntry> * ;
          d3f:published @<D3fendDateTime> ? ;
          d3f:quarantines @<D3fendEntry> * ;
          d3f:queries @<D3fendEntry> * ;
          d3f:rating @linkml:String ? ;
          d3f:reads @<D3fendEntry> * ;
          d3f:receives @<D3fendEntry> * ;
          d3f:recorded-in @<D3fendEntry> * ;
          d3f:records @<D3fendEntry> * ;
          d3f:regenerates @<D3fendEntry> * ;
          d3f:related @<D3fendEntry> * ;
          d3f:release-date @linkml:String ? ;
          d3f:restores @<D3fendEntry> * ;
          d3f:restricted-by @<D3fendEntry> * ;
          d3f:restricts @<D3fendEntry> * ;
          d3f:resumes @<D3fendEntry> * ;
          d3f:risk-impact @linkml:Integer ? ;
          d3f:risk-likelihood @linkml:Integer ? ;
          d3f:runs @<D3fendEntry> * ;
          rdfs:seeAlso @linkml:String * ;
          d3f:semantic-relation @<D3fendEntry> * ;
          d3f:signed-by @<D3fendEntry> * ;
          d3f:signs @<D3fendEntry> * ;
          skos:prefLabel @linkml:String * ;
          d3f:spoofs @<D3fendEntry> * ;
          d3f:stage @linkml:String ? ;
          d3f:start @<D3fendEntry> * ;
          d3f:strengthens @<D3fendEntry> * ;
          d3f:summarizes @<D3fendEntry> * ;
          d3f:suspends @<D3fendEntry> * ;
          d3f:synonym @linkml:String * ;
          d3f:terminates @<D3fendEntry> * ;
          d3f:text @linkml:String ? ;
          d3f:title @linkml:String ? ;
          d3f:transmits @<D3fendEntry> * ;
          d3f:unloads @<D3fendEntry> * ;
          d3f:unmounts @<D3fendEntry> * ;
          d3f:updates @<D3fendEntry> * ;
          d3f:use-limits @<D3fendEntry> * ;
          d3f:used-by @<D3fendEntry> * ;
          d3f:uses @<D3fendEntry> * ;
          d3f:valid @<D3fendDateTime> ? ;
          d3f:validated-by @<D3fendEntry> * ;
          d3f:validates @<D3fendEntry> * ;
          d3f:verifies @<D3fendEntry> * ;
          d3f:version @linkml:String ? ;
          d3f:weakness-of @<D3fendEntry> * ;
          d3f:windows-registry-key @linkml:String ? ;
          d3f:windows-registry-value @linkml:String ? ;
          d3f:writes @<D3fendEntry> *
       ) ;
       rdf:type [ <D3fendEntry> ]
    )
}

<D3fendEvent> CLOSED {
    (  $<D3fendEvent_tes> (  &<D3fendEntry_tes> ;
          rdf:type [ <D3fendEntry> ] ? ;
          d3f:has-input @<D3fendArtifact> * ;
          d3f:has-output @<D3fendArtifact> *
       ) ;
       rdf:type [ d3f:Event ]
    )
}

<D3fendExternalControl>  (
    CLOSED {
       (  $<D3fendExternalControl_tes> (  &<D3fendEntry_tes> ;
             rdf:type [ <D3fendEntry> ] ?
          ) ;
          rdf:type [ d3f:ExternalControl ]
       )
    } OR @<D3fendCciControl> OR @<D3fendNistControl>
)

<D3fendGoal>  (
    CLOSED {
       (  $<D3fendGoal_tes> (  &<D3fendEntry_tes> ;
             rdf:type [ <D3fendEntry> ] ?
          ) ;
          rdf:type [ d3f:Goal ]
       )
    } OR @<D3fendDefensiveTactic> OR @<D3fendOffensiveTactic>
)

<D3fendNistControl> CLOSED {
    (  $<D3fendNistControl_tes> (  &<D3fendExternalControl_tes> ;
          rdf:type [ d3f:ExternalControl ] ?
       ) ;
       rdf:type [ d3f:NISTControl ]
    )
}

<D3fendOffensiveTactic> CLOSED {
    (  $<D3fendOffensiveTactic_tes> (  &<D3fendGoal_tes> ;
          rdf:type [ d3f:Goal ] ?
       ) ;
       rdf:type [ d3f:OffensiveTactic ]
    )
}

<D3fendOffensiveTechnique> CLOSED {
    (  $<D3fendOffensiveTechnique_tes> (  &<D3fendTechnique_tes> ;
          rdf:type [ d3f:Technique ] ?
       ) ;
       rdf:type [ d3f:OffensiveTechnique ]
    )
}

<D3fendTechnique>  (
    CLOSED {
       (  $<D3fendTechnique_tes> (  &<D3fendEntry_tes> ;
             rdf:type [ <D3fendEntry> ] ? ;
             d3f:kb-reference @<D3fendEntry> *
          ) ;
          rdf:type [ d3f:Technique ]
       )
    } OR @<D3fendAnalyticTechnique> OR @<D3fendDefensiveTechnique> OR @<D3fendOffensiveTechnique>
)

<D3fendTechniqueReference> CLOSED {
    (  $<D3fendTechniqueReference_tes> (  &<D3fendEntry_tes> ;
          rdf:type [ <D3fendEntry> ] ? ;
          d3f:kb-author @linkml:String ? ;
          d3f:kb-mitre-analysis @linkml:String ?
       ) ;
       rdf:type [ d3f:TechniqueReference ]
    )
}

<D3fendThing> CLOSED {
    (  $<D3fendThing_tes> (  &<D3fendEntry_tes> ;
          rdf:type [ <D3fendEntry> ] ?
       ) ;
       rdf:type [ <D3fendThing> ]
    )
}

<D3fendThreatModelTechnique> CLOSED {
    (  $<D3fendThreatModelTechnique_tes> (  &<D3fendThreatModelThing_tes> ;
          rdf:type [ d3f:ExternalThreatModelThing ] ?
       ) ;
       rdf:type [ <D3fendThreatModelTechnique> ]
    )
}

<D3fendThreatModelThing>  (
    CLOSED {
       (  $<D3fendThreatModelThing_tes> (  &<D3fendEntry_tes> ;
             rdf:type [ <D3fendEntry> ] ?
          ) ;
          rdf:type [ d3f:ExternalThreatModelThing ]
       )
    } OR @<D3fendAttackDataSource> OR @<D3fendAttackMitigation> OR @<D3fendThreatModelTechnique>
)

<D3fendWeakness> CLOSED {
    (  $<D3fendWeakness_tes> (  &<D3fendEntry_tes> ;
          rdf:type [ <D3fendEntry> ] ? ;
          d3f:may-be-weakness-of @<D3fendArtifact> *
       ) ;
       rdf:type [ d3f:Weakness ]
    )
}
